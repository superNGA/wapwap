///////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////
static size_t linelen(const char *s) 
{
	size_t l = 0;
	while (s[l] != '\0' && s[l] != '\n')
		++l;

	return l;
}


///////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////
static void ww_expand_tabs_inplace(char *str)
{
	size_t tab_size = 4;
	size_t shift_size = tab_size - 1;
	size_t i = 0;
	int tabs = 0;
	while (str[i] != '\0' && str[i] != '\n') {
		if (str[i] == '\t') {
			for (size_t j = linelen(str); j > i; --j)
				str[j + shift_size] = str[j];
			for (size_t j = i; j < i + tab_size; ++j)
				str[j] = ' ';
		}
		++i;
	}

	str[i] = '\0';
}


///////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////
static void ww_pushfront_str(char *dest, char *src)
{
	size_t numlen = strlen(src);
	size_t len = strlen(dest);
	for (int i = len + 1; i >= 0; --i)
		dest[i + numlen] = dest[i];
	for (int i = 0; i < numlen; ++i)
		dest[i] = src[i];
	return;
}


///////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////
static void ww_add_linenum(char *dest, int num)
{
	// "16 digit" lines of code is big enough. 
	char tmp[16] = {0};
	snprintf(tmp, sizeof(tmp), " %3d ", num);
	ww_pushfront_str(dest, tmp);
}


///////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////
static int ww_count_char(char *haystack, char c)
{
	int i = 0;
	while (*haystack != '\0') {
		if (*haystack == c)
			++i;
		++haystack;
	}

	return i;
}


