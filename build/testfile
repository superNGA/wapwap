static int ww_do_task(struct wapwap_state *s, struct config *c, struct file_entity *task)
{
	// NOTE : select and apply font here so all further font size calculations are accurate to 
	// the purpose.
	HPDF_Font font      = NULL;
	float     font_size = -1.0;
	bool      linenum   = false;

	switch (task->type) {
	case FILEENTITY_CODE_BLOCK:
		font      = s->codetext_font;
		font_size = c->code_size;
		linenum   = true;
		break;
	case FILEENTITY_HEADING:
		font      = s->heading_font;
		font_size = c->heading_size;
		break;
	case FILEENTITY_TEXT:
		font      = s->text_font;
		font_size = c->text_size;
		break;
	}
	HPDF_Page_SetFontAndSize(ww_get_active_page(s), font, font_size);

	std::vector<txtline> ll; ll.clear();
	if (ww_gen_linelist(s, c, task, &ll, linenum) != OK)
		return ER;

	for (size_t i = 0; i < ll.size(); ++i)
		printf("[%d] %s\n", ll[i].flags, ll[i].txt);

	return OK;
}


///////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////
static int ww_gen_linelist(struct wapwap_state *s, struct config *c, struct file_entity *task, std::vector<txtline> *ll, bool linenum)
{
	for (int i = 0; i < task->data.size(); ++i) {
		entity_data *d      = &task->data[i];
		HPDF_Page   curpage = ww_get_active_page(s);

		switch (d->type) {
		case ENTITYDATA_TEXT:
		{
			size_t len  = strlen(d->data);
			int    tabs = ww_count_char(d->data, '\t');
			char   *src = (char*)calloc(len + (TAB_SIZE - 1) * tabs + (linenum ? 10 : 0) + 1, 1);
			if (!src) {
				FATAL_LOG("failed calloc. bad place to be in ngl");
				return ER;
			}
			strncpy(src, d->data, len);

			ww_line_chop_n_tag(s, c, src, ll, linenum);
			free(src);
			break;
		}
		case ENTITYDATA_FILE:
		{
			FILE *f = fopen(d->data, "r");
			// FILE *f = fopen("./practical_001.cpp", "r");
			if (!f) {
				FAIL_LOG("failed to open file : %s", d->data);
				return ER;
			}

			char *buf = NULL; size_t buflen = 0;
			while (getline(&buf, &buflen, f) > 0) {
				int  tabs     = ww_count_char(d->data, '\t');
				char *new_buf = (char*)calloc(buflen + (TAB_SIZE - 1) * tabs + (linenum ? 10 : 0) + 1, 1);
				strncpy(new_buf, buf, buflen);

				ww_line_chop_n_tag(s, c, new_buf, ll, linenum);
				free(buf); buf = NULL;
			}

			fclose(f);
			break;
		}
		case ENTITYDATA_SHELLCMD:
		{
			FILE *f = popen(d->data, "r");
			if (!f) {
				FAIL_LOG("failed to open file : %s", d->data);
				return ER;
			}

			char *buf = NULL; size_t buflen = 0;
			while (getline(&buf, &buflen, f) > 0) {
				int  tabs     = ww_count_char(d->data, '\t');
				char *new_buf = (char*)calloc(buflen + (TAB_SIZE - 1) * tabs + (linenum ? 10 : 0) + 1, 1);
				strncpy(new_buf, buf, buflen);

				ww_line_chop_n_tag(s, c, new_buf, ll, linenum);
				free(buf); buf = NULL;
			}

			pclose(f);
			break;
		}
		}
		LOG("Child done");
	}
	return OK;
}


///////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////
static int ww_line_chop_n_tag(struct wapwap_state *s, struct config *c, char *src, std::vector<txtline> *ll, bool linenum)
{
	bool is_comment = ww_is_comment(src);


	// expand tabs & add linenum
	ww_expand_tabs_inplace(src);
	if (linenum)
		ww_add_linenum(src, (int)ll->size());


	// Split the line
	HPDF_Page curpage = ww_get_active_page(s);
	float     pwidth  = HPDF_Page_GetWidth(curpage);

	std::vector<char*> split_lines; split_lines.clear();
	ww_split_line(curpage, pwidth - MARGIN_LEFT - MARGIN_RIGHT, src, &split_lines);

	if (split_lines.empty()) // empty line
		split_lines.push_back((char*)calloc(1,1));


	// pushback the split up lines into line_out & adjust line flags.
	for (int i = 0; i < split_lines.size(); ++i) {
		struct txtline new_line;
		new_line.txt = split_lines[i];
		new_line.flags = 0;
		if (is_comment)
			new_line.flags |= lineflag_comment;

		ll->push_back(new_line);
	}

	return OK;
}


