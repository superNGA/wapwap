static int ww_pushback_a4page(struct wapwap_state *s)
{
	HPDF_Page page = HPDF_AddPage(s->pdf);
	HPDF_Page_SetSize(page, HPDF_PAGE_SIZE_A4, HPDF_PAGE_PORTRAIT);
	s->book.push_back(page);
	s->lines_lastpage = 0;
	LOG("Added new page");
	return OK;
}


